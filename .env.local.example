# Copy this file to .env.local and fill in your key. Never commit .env.local.

# Required for every mode. STT, TTS and the LLM gateway all use this one key.
# Get it from https://www.assemblyai.com/app (account / API keys).
ASSEMBLYAI_API_KEY=your-assemblyai-key-here

# Optional. When set, the conversation runs on OpenRouter instead of AssemblyAI's
# gateway, which reaches many more models. Speech-to-text and text-to-speech still use
# the AssemblyAI key above. Get a key at https://openrouter.ai/keys
# The model MUST support tool calling, or the agent loses all its tools; filter with
# https://openrouter.ai/models?supported_parameters=tools
# Free and tool-capable: google/gemma-4-31b-it:free (same family as the default),
# nvidia/nemotron-3.5-lightning:free, nvidia/nemotron-3.5-super-vl:free
# Cheap, paid, and stronger: z-ai/glm-5.3-flash, qwen/qwen3.7-flash, openai/gpt-oss-120b
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Optional. When set, web_search uses Firecrawl (cleaner, more reliable results).
# Without it, web_search falls back to a DuckDuckGo scrape. No code change needed either way.
# Get a key from https://www.firecrawl.dev/app/api-keys.
# FIRECRAWL_API_KEY=fc-your-firecrawl-key-here

# Needed for email. draft_email saves the draft into your Gmail Drafts folder over IMAP,
# so you can read and edit it in Gmail; send_email then sends it over SMTP and clears that
# saved copy. Without these, the agent can still compose a draft and read it aloud.
# Gmail refuses your normal password
# over SMTP, so this must be an "app password": turn on 2-step verification at
# https://myaccount.google.com/security then create one at
# https://myaccount.google.com/apppasswords and paste the 16 characters below.
# GMAIL_ADDRESS is also what "send it to me" resolves to.
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=abcdefghijklmnop

# Needed for look_at_screen, which sends a screenshot to Gemini to answer about it.
# The AssemblyAI gateway's free models don't accept images, so this is a separate key.
# It's free with no credit card: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-key-here

# Optional. github_repo_summary works without it on public repos (60 requests an hour).
# A token raises that to 5000 an hour and lets it read your private repos too.
# Make one at https://github.com/settings/tokens (a classic token with no scopes is
# enough for public repos; tick "repo" if you want private ones).
# GITHUB_TOKEN=ghp_your-token-here

# Needed to connect to LiveKit Cloud for a web or phone frontend (`dev` or `start` mode).
# NOT needed for `console` mode, which runs entirely on your machine.
# Get these from https://cloud.livekit.io (Project settings / Keys).
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your-livekit-api-key
# LIVEKIT_API_SECRET=your-livekit-api-secret

# Set HOSTED=1 only when running on a server (it's already set in the Dockerfile).
# It turns off the tools that control a computer (apps, Spotify, YouTube, reading pages)
# and keeps web_search and the time. Leave it unset on your laptop for the full assistant.
# HOSTED=1
